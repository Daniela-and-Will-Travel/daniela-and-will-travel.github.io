---
/**
 * Every blog post, at /<lang>/<segment>/<slug>/.
 *
 * A rest parameter rather than nested [lang]/[segment]/[slug] folders, because
 * the segment differs per language ("writing" in English) and a three-deep
 * dynamic route would collide with the tag archives. Astro ranks static and
 * non-rest dynamic routes above this one, so the explicit pages still win.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import Post from '@layouts/Post.astro';
import { getPosts, getRelatedPosts, postLang, postUrl } from '@lib/posts';

export const getStaticPaths = (async () => {
    const posts = await getPosts();

    return Promise.all(
        posts.map(async (post) => ({
            // Astro wants the rest param without its leading or trailing slash.
            params: { slug: postUrl(post).slice(1, -1) },
            props: {
                post,
                lang: postLang(post),
                related: await getRelatedPosts(post)
            }
        }))
    );
}) satisfies GetStaticPaths;

const { post, lang, related } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} lang={lang} related={related}>
    <Content />
</Post>
