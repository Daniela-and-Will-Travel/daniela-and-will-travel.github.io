---
/**
 * The living style guide.
 *
 * Every example is rendered with the real stylesheet, so a component that
 * changes here has changed everywhere. To add one, declare its markup as a
 * template literal below and hand it to <Story>; the same string is rendered
 * live and printed as source, which is what keeps this page honest.
 */
import Base from '@layouts/Base.astro';
import Figure from '@components/Figure.astro';
import Story from '@components/styleguide/Story.astro';
import Swatch from '@components/styleguide/Swatch.astro';
import { Code } from 'astro:components';
import { getImage } from 'astro:assets';
import { resolveImage } from '@lib/images';

export const meta = { excludeFromSitemap: true };

// The card, tile and hero stories embed a plain <img> so the story markup shows
// the component's structure rather than the image pipeline. Those paths are the
// authoring paths, which no longer exist as URLs now that photographs are
// hashed by astro:assets — so resolve them here and render the canvas with the
// real URLs, while <Story source> keeps printing the readable original.
const demoImagePaths = [
    "/assets/img/posts/asia/komodocover.jpg",
    "/assets/img/posts/asia/lombokcover.JPEG",
    "/assets/img/posts/europe/IMG_7233.jpg",
    "/assets/img/posts/asia/cover.jpg",
    "/assets/img/en.jpg"
];

const demoImageUrls = new Map<string, string>(
    await Promise.all(
        demoImagePaths.map(async (src): Promise<[string, string]> => {
            const optimized = await getImage({
                src: await resolveImage(src),
                width: 1200,
                format: 'webp'
            });
            return [src, optimized.src];
        })
    )
);

const withLiveImages = (markup: string): string =>
    markup.replace(/src="([^"]+)"/g, (match, src) =>
        demoImageUrls.has(src) ? `src="${demoImageUrls.get(src)}"` : match
    );


